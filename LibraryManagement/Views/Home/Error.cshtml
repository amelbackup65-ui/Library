@model LibraryManagement.Models.ViewModels.Common.ErrorViewModel
@{
    ViewData["Title"] = "خطا در پردازش درخواست";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
                <div class="text-danger mb-3 fs-1">⚠️</div>
                <h2 class="h4 fw-bold text-dark mb-3">خطایی رخ داده است</h2>
                <p class="text-muted mb-4">
                    متأسفانه در حین پردازش درخواست شما خطایی در سرور رخ داده است. این موضوع ثبت شده و تیم پشتیبانی در حال پیگیری آن می‌باشد.
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border small text-muted text-break mb-4">
                        <strong class="text-dark">شناسه پیگیری (Request ID):</strong>
                        <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                        بازگشت به داشبورد
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                        صفحه قبل
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
