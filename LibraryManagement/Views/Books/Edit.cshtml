@model LibraryManagement.Models.ViewModels.Books.BookEditViewModel
@{
    ViewData["Title"] = "ویرایش کتاب";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">ویرایش اطلاعات کتاب</h3>
                <p class="text-muted small mb-0">کد شناسایی کتاب: @Model.Id • شابک: @Model.ISBN</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    بازگشت به فهرست
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="AvailableCopies" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-semibold small"></label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ISBN" class="form-label fw-semibold small"></label>
                            <input asp-for="ISBN" class="form-control" dir="ltr" required />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold small"></label>
                            <select asp-for="CategoryId" asp-items="Model.CategoryList" class="form-select" required></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Publisher" class="form-label fw-semibold small"></label>
                            <input asp-for="Publisher" class="form-control" />
                            <span asp-validation-for="Publisher" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="PublishYear" class="form-label fw-semibold small"></label>
                            <input asp-for="PublishYear" type="number" class="form-control" required />
                            <span asp-validation-for="PublishYear" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PageCount" class="form-label fw-semibold small"></label>
                            <input asp-for="PageCount" type="number" class="form-control" required />
                            <span asp-validation-for="PageCount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TotalCopies" class="form-label fw-semibold small"></label>
                            <input asp-for="TotalCopies" type="number" class="form-control" min="1" max="1000" required />
                            <span asp-validation-for="TotalCopies" class="text-danger small"></span>
                            <div class="form-text small text-info">
                                موجودی فعلی در قفسه: <strong>@Model.AvailableCopies</strong> نسخه
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SelectedAuthorIds" class="form-label fw-semibold small"></label>
                        <select asp-for="SelectedAuthorIds" asp-items="Model.AuthorList" class="form-select" multiple size="4"></select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">انصراف</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
