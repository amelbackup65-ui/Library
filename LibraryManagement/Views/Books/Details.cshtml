@model LibraryManagement.Models.ViewModels.Books.BookDetailsViewModel
@{
    ViewData["Title"] = "جزئیات کتاب - " + Model.Title;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">شناسنامه و جزئیات کتاب</h3>
        <p class="text-muted small mb-0">کد کتاب در سامانه: @Model.Id</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            ✏️ ویرایش کتاب
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            بازگشت به فهرست
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- ستون مشخصات کتاب -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h4 class="fw-bold text-dark mb-2">@Model.Title</h4>
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1">
                            @Model.CategoryName
                        </span>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small">شابک:</span>
                        <div class="font-monospace fw-bold" dir="ltr">@Model.ISBN</div>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-secondary small mb-2">خلاصه و معرفی کتاب:</h6>
                    <p class="text-muted leading-relaxed">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "توضیحاتی برای این کتاب ثبت نشده است." : Model.Description)
                    </p>
                </div>

                <div class="row g-3 py-3 border-top border-bottom mb-4">
                    <div class="col-sm-4">
                        <div class="text-muted small">ناشر:</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Publisher) ? "نامشخص" : Model.Publisher)</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">سال چاپ:</div>
                        <div class="fw-semibold">@Model.PublishYear</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">تعداد صفحات:</div>
                        <div class="fw-semibold">@Model.PageCount صفحه</div>
                    </div>
                </div>

                <h6 class="fw-bold text-secondary small mb-3">پدیدآورندگان و نویسندگان:</h6>
                @if (!Model.Authors.Any())
                {
                    <p class="text-muted small">هیچ نویسنده‌ای برای این کتاب متصل نشده است.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var author in Model.Authors)
                        {
                            <div class="p-2 px-3 bg-light rounded border border-secondary border-opacity-10">
                                <div class="fw-bold text-dark small">✍️ @author.FullName</div>
                                @if (!string.IsNullOrWhiteSpace(author.Biography))
                                {
                                    <div class="text-muted text-truncate" style="max-width: 280px; font-size: 11px;">
                                        @author.Biography
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- سوابق امانت‌های کتاب -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark">آخرین گردش‌های امانت این کتاب</h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.LoansHistory.Any())
                {
                    <div class="p-4 text-center text-muted small">
                        تاکنون هیچ امانتی برای این کتاب ثبت نشده است.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>امانت‌گیرنده</th>
                                    <th>تاریخ امانت</th>
                                    <th>موعد سررسید</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var loan in Model.LoansHistory)
                                {
                                    <tr>
                                        <td>@loan.Member?.FullName</td>
                                        <td>@loan.LoanDate.ToLocalTime().ToString("yyyy/MM/dd")</td>
                                        <td>@loan.DueDate.ToLocalTime().ToString("yyyy/MM/dd")</td>
                                        <td>
                                            @if (loan.Status == LibraryManagement.Models.Entities.LoanStatus.Active)
                                            {
                                                <span class="badge bg-warning text-dark">در دست امانت</span>
                                            }
                                            else if (loan.Status == LibraryManagement.Models.Entities.LoanStatus.Returned)
                                            {
                                                <span class="badge bg-success">عودت داده شده</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">دارای دیرکرد</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ستون وضعیت نسخه‌ها و موجودی قفسه -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark">وضعیت موجودی در مخزن</h6>
            </div>
            <div class="card-body p-4 text-center">
                <div class="display-5 fw-bold text-primary mb-1">
                    @Model.AvailableCopies
                </div>
                <div class="text-muted small mb-3">نسخه آزاد و آماده امانت</div>

                <div class="progress mb-3" style="height: 8px;">
                    @{
                        int percent = Model.TotalCopies > 0 ? (Model.AvailableCopies * 100) / Model.TotalCopies : 0;
                    }
                    <div class="progress-bar bg-success" role="progressbar" style="width: @percent%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="d-flex justify-content-between small text-muted border-top pt-3">
                    <span>کل نسخه‌ها: <strong>@Model.TotalCopies</strong></span>
                    <span>در امانت: <strong>@Model.LoanedCopies</strong></span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body p-3 small text-muted">
                <div>تاریخ ثبت در سامانه: @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div>آخرین ویرایش: @Model.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                }
            </div>
        </div>
    </div>
</div>
