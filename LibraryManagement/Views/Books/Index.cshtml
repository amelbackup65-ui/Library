@model LibraryManagement.Models.ViewModels.Books.BookListViewModel
@{
    ViewData["Title"] = "مدیریت کتاب‌ها";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">فهرست کتاب‌ها</h3>
        <p class="text-muted small mb-0">جستجو، ویرایش و ثبت اطلاعات کتاب‌ها و کنترل موجودی نسخه‌ها</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <span>➕</span> ثبت کتاب جدید
        </a>
    </div>
</div>

<!-- فرم فیلتر و جستجو -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="جستجوی عنوان، شابک، ناشر یا نام نویسنده..." />
            </div>
            <div class="col-md-3">
                <select name="categoryId" asp-items="Model.CategoryList" class="form-select">
                    <option value="">-- همه دسته‌بندی‌ها --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="sortOrder" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">جدیدترین‌های ثبت‌شده</option>
                    <option value="title_asc" selected="@(Model.SortOrder == "title_asc")">عنوان (الف تا ی)</option>
                    <option value="title_desc" selected="@(Model.SortOrder == "title_desc")">عنوان (ی تا الف)</option>
                    <option value="year_desc" selected="@(Model.SortOrder == "year_desc")">سال چاپ (جدیدترین)</option>
                    <option value="copies_desc" selected="@(Model.SortOrder == "copies_desc")">بیشترین موجودی در قفسه</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100">اعمال فیلتر</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.CategoryId.HasValue || !string.IsNullOrEmpty(Model.SortOrder))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="پاک‌کردن فیلترها">✖</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- جدول کتاب‌ها -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Books.Items.Any())
        {
            <div class="text-center py-5 text-muted">
                <div class="fs-1 mb-2">🔍</div>
                <h5>هیچ کتابی با مشخصات جستجوشده یافت نشد!</h5>
                <p class="small">لطفاً عبارت دیگری را جستجو کنید یا فیلتر دسته‌بندی را تغییر دهید.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 28%;">عنوان و شابک</th>
                            <th>نویسندگان</th>
                            <th>دسته‌بندی</th>
                            <th>سال انتشار</th>
                            <th class="text-center">موجودی / کل</th>
                            <th class="text-center" style="width: 18%;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.Books.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@book.Title</div>
                                    <div class="text-muted small font-monospace" dir="ltr">ISBN: @book.ISBN</div>
                                </td>
                                <td>
                                    <span class="small">@(string.IsNullOrWhiteSpace(book.AuthorsDisplay) ? "—" : book.AuthorsDisplay)</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                                        @book.CategoryName
                                    </span>
                                </td>
                                <td>@book.PublishYear</td>
                                <td class="text-center">
                                    @if (book.AvailableCopies > 0)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            @book.AvailableCopies از @book.TotalCopies
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">
                                            ناموجود (امانت رفته)
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-info" title="مشاهده جزئیات">
                                            جزئیات
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-outline-primary" title="ویرایش">
                                            ویرایش
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <button type="button" class="btn btn-outline-danger delete-book-btn" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#deleteBookModal" 
                                                    data-book-id="@book.Id" 
                                                    data-book-title="@book.Title">
                                                حذف
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- بخش صفحه‌بندی (Pagination) -->
            @if (Model.Books.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top">
                    <div class="small text-muted">
                        نمایش صفحه @Model.Books.PageIndex از @Model.Books.TotalPages (مجموعاً @Model.Books.TotalCount کتاب)
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.Books.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.Books.PageIndex - 1)" 
                                   asp-route-searchTerm="@Model.SearchTerm" 
                                   asp-route-categoryId="@Model.CategoryId" 
                                   asp-route-sortOrder="@Model.SortOrder">قبلی</a>
                            </li>
                            @for (int i = 1; i <= Model.Books.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Books.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-page="@i" 
                                       asp-route-searchTerm="@Model.SearchTerm" 
                                       asp-route-categoryId="@Model.CategoryId" 
                                       asp-route-sortOrder="@Model.SortOrder">@i</a>
                                </li>
                            }
                            <li class="page-item @(!Model.Books.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.Books.PageIndex + 1)" 
                                   asp-route-searchTerm="@Model.SearchTerm" 
                                   asp-route-categoryId="@Model.CategoryId" 
                                   asp-route-sortOrder="@Model.SortOrder">بعدی</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- مودال تایید حذف کتاب (ویژه مدیر سیستم) -->
<div class="modal fade" id="deleteBookModal" tabindex="-1" aria-labelledby="deleteBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteBookModalLabel">تایید حذف کتاب</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف دائم کتاب <strong id="modalBookTitle" class="text-danger"></strong> مطمئن هستید؟</p>
                <div class="alert alert-warning small mb-0">
                    توجه: در صورتی که برای این کتاب سابقه امانت فعال وجود داشته باشد، سیستم اجازه حذف آن را نخواهد داد.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <form id="deleteBookForm" asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalBookId" value="" />
                    <button type="submit" class="btn btn-danger">بله، حذف شود</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/books.js"></script>
}
