@model LibraryManagement.Models.ViewModels.Books.BookCreateViewModel
@{
    ViewData["Title"] = "ثبت کتاب جدید";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">ثبت کتاب جدید در کاتالوگ</h3>
                <p class="text-muted small mb-0">اطلاعات شناسنامه‌ای، دسته‌بندی و تعداد نسخه‌های کتاب را وارد نمایید</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    بازگشت به فهرست
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-semibold small"></label>
                            <input asp-for="Title" class="form-control" placeholder="مثال: طراحی الگوهای شی‌گرا (Design Patterns)" required autofocus />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ISBN" class="form-label fw-semibold small"></label>
                            <input asp-for="ISBN" class="form-control" dir="ltr" placeholder="978-0201633610" required />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold small"></label>
                            <select asp-for="CategoryId" asp-items="Model.CategoryList" class="form-select" required>
                                <option value="">-- انتخاب دسته‌بندی موضوعی --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Publisher" class="form-label fw-semibold small"></label>
                            <input asp-for="Publisher" class="form-control" placeholder="مثال: انتشارات نص" />
                            <span asp-validation-for="Publisher" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="PublishYear" class="form-label fw-semibold small"></label>
                            <input asp-for="PublishYear" type="number" class="form-control" min="1000" max="2100" required />
                            <span asp-validation-for="PublishYear" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PageCount" class="form-label fw-semibold small"></label>
                            <input asp-for="PageCount" type="number" class="form-control" min="1" required />
                            <span asp-validation-for="PageCount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TotalCopies" class="form-label fw-semibold small"></label>
                            <input asp-for="TotalCopies" type="number" class="form-control" min="1" max="1000" required />
                            <span asp-validation-for="TotalCopies" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SelectedAuthorIds" class="form-label fw-semibold small"></label>
                        <select asp-for="SelectedAuthorIds" asp-items="Model.AuthorList" class="form-select" multiple size="4">
                        </select>
                        <div class="form-text small text-muted">
                            برای انتخاب چند نویسنده، کلید Ctrl (در ویندوز) یا Command (در مک) را نگه دارید و کلیک نمایید.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="توضیحاتی در خصوص سرفصل‌ها یا خلاصه کتاب..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">انصراف</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            ذخیره و ثبت کتاب
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
