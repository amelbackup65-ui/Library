@model LibraryManagement.Models.ViewModels.Loans.LoanDetailsViewModel
@{
    ViewData["Title"] = "رسید و جزئیات امانت #" + Model.Id;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">رسید امانت کتاب شماره #@Model.Id</h3>
        <p class="text-muted small mb-0">اطلاعات پرونده و وضعیت گردش کتاب در مخزن</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != LibraryManagement.Models.Entities.LoanStatus.Returned)
        {
            <form asp-action="Return" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success" onclick="return confirm('آیا کتاب با موفقیت تحویل گرفته شد؟');">
                    تحویل و بازگشت کتاب به قفسه
                </button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">بازگشت به فهرست</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark">مشخصات امانت‌گیرنده و کتاب</span>
                <div>
                    @if (Model.Status == LibraryManagement.Models.Entities.LoanStatus.Returned)
                    {
                        <span class="badge bg-success">کتاب بازگردانده شده</span>
                    }
                    else if (Model.IsOverdue)
                    {
                        <span class="badge bg-danger">امانت منقضی (دارای تاخیر)</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">امانت در دست عضو</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6 border-start">
                        <h6 class="fw-bold text-secondary small mb-3">مشخصات کتاب:</h6>
                        <div class="h5 fw-bold text-dark mb-1">@Model.Book.Title</div>
                        <div class="text-muted small font-monospace mb-2" dir="ltr">ISBN: @Model.Book.ISBN</div>
                        <div class="small text-muted">دسته‌بندی: @Model.Book.Category?.Name</div>
                        <div class="small text-muted">موجودی فعلی در قفسه: <strong>@Model.Book.AvailableCopies</strong> از @Model.Book.TotalCopies نسخه</div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-secondary small mb-3">مشخصات امانت‌گیرنده:</h6>
                        <div class="h5 fw-bold text-dark mb-1">@Model.Member.FullName</div>
                        <div class="text-muted small font-monospace mb-1" dir="ltr">کد ملی: @Model.Member.NationalCode</div>
                        <div class="text-muted small font-monospace" dir="ltr">تلفن: @Model.Member.Phone</div>
                    </div>
                </div>

                <div class="row g-3 py-3 border-top mt-4">
                    <div class="col-sm-4">
                        <div class="text-muted small">تاریخ شروع امانت:</div>
                        <div class="fw-bold">@Model.LoanDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">موعد مقرر سررسید:</div>
                        <div class="fw-bold @(Model.IsOverdue ? "text-danger" : "")">
                            @Model.DueDate.ToLocalTime().ToString("yyyy/MM/dd")
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">تاریخ واقعی بازگشت:</div>
                        <div class="fw-bold text-success">
                            @(Model.ReturnDate.HasValue ? Model.ReturnDate.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm") : "هنوز تحویل داده نشده")
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-3 p-3 bg-light rounded">
                        <span class="text-secondary fw-semibold small">یادداشت ثبت‌شده:</span>
                        <p class="mb-0 small text-muted mt-1">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 p-4 text-center">
            <h6 class="fw-bold text-dark mb-3">قوانین و ضمانت اجرایی</h6>
            <p class="small text-muted leading-relaxed mb-0">
                بر اساس ضوابط کتابخانه، تا زمان تسویه کامل این امانت و ثبت تحویل در سیستم، عضو مربوطه امکان دریافت کتاب جدید نخواهد داشت و در صورت تاخیر، جریمه دیرکرد روزانه در سوابق عضو لحاظ می‌گردد.
            </p>
        </div>
    </div>
</div>
