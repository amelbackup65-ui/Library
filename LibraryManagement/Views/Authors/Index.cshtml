@model IEnumerable<LibraryManagement.Models.ViewModels.Authors.AuthorItemViewModel>
@{
    ViewData["Title"] = "مدیریت نویسندگان";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">فهرست نویسندگان و پدیدآورندگان</h3>
        <p class="text-muted small mb-0">مشاهده سوابق تالیف و اتصال نویسندگان به کتاب‌ها</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <span>➕</span> ثبت نویسنده جدید
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <h5>هیچ نویسنده‌ای در سیستم ثبت نشده است.</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%;">نام و نام خانوادگی</th>
                            <th>زندگی‌نامه مختصر</th>
                            <th class="text-center" style="width: 15%;">تعداد کتب در کتابخانه</th>
                            <th class="text-center" style="width: 20%;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var author in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">
                                    ✍️ @author.FullName
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(author.Biography) ? "—" : author.Biography)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1">
                                        @author.BooksCount عنوان کتاب
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@author.Id" class="btn btn-outline-info">جزئیات</a>
                                        <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-outline-primary">ویرایش</a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <button type="button" class="btn btn-outline-danger delete-author-btn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteAuthorModal"
                                                    data-author-id="@author.Id"
                                                    data-author-name="@author.FullName">
                                                حذف
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- مودال تایید حذف نویسنده -->
<div class="modal fade" id="deleteAuthorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">تایید حذف نویسنده</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف نویسنده <strong id="modalAuthorName" class="text-danger"></strong> اطمینان دارید؟</p>
                <div class="alert alert-warning small mb-0">
                    نکته: در صورتی که کتاب‌هایی به این نویسنده متصل باشند، امکان حذف وجود ندارد.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <form id="deleteAuthorForm" asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalAuthorId" value="" />
                    <button type="submit" class="btn btn-danger">بله، حذف شود</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const deleteButtons = document.querySelectorAll('.delete-author-btn');
            const modalAuthorId = document.getElementById('modalAuthorId');
            const modalAuthorName = document.getElementById('modalAuthorName');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    modalAuthorId.value = btn.getAttribute('data-author-id');
                    modalAuthorName.textContent = `«${btn.getAttribute('data-author-name')}»`;
                });
            });
        });
    </script>
}
