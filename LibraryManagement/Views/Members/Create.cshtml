@model LibraryManagement.Models.ViewModels.Members.MemberFormViewModel
@{
    ViewData["Title"] = "ثبت‌نام عضو جدید";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">ثبت‌نام عضو جدید کتابخانه</h3>
                <p class="text-muted small mb-0">مشخصات هویتی و اطلاعات تماس عضو را وارد فرمایید</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">بازگشت به فهرست</a>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold small"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="مثال: سارا" required autofocus />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold small"></label>
                            <input asp-for="LastName" class="form-control" placeholder="مثال: کریمی" required />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="NationalCode" class="form-label fw-semibold small"></label>
                            <input asp-for="NationalCode" class="form-control font-monospace" dir="ltr" maxlength="10" placeholder="0012345678" required />
                            <span asp-validation-for="NationalCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small"></label>
                            <input asp-for="Phone" class="form-control font-monospace" dir="ltr" maxlength="11" placeholder="09123456789" required />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" type="email" class="form-control font-monospace" dir="ltr" placeholder="user@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Address" class="form-control" rows="2" placeholder="نشانی پستی محل سکونت..."></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold small"></label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">انصراف</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">تکمیل ثبت‌نام عضو</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
